+/** Read-only Native Agent Mode label in a running session header. */
+import { useEffect } from 'react'
+import type { SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { IconAgentPresetOutline16 as IconAgentModeOutline16 } from '@deepseek-ai/dsh-client-ui-primitives'
+import type {} from '@deepseek-ai/dsh-client-ui-conversation/client'
+import type { AgentModeSettingsState } from './settings-store.ts'
+import { modeDisplayText } from './locales.ts'
+import { modeIdFromSession } from './mode-wire.ts'
+import css from './AgentModeLabel.module.css'
+
+export interface AgentModeLabelInjected {
+  hooks: { agentModes: SnapshotStore<AgentModeSettingsState> }
+  load: () => Promise<void>
+}
+
+export type AgentModeLabelProps =
+  PropsRuntime<'conversation.session.header.actions'>
+  & PropsLocale<'settings.agentMode'>
+  & InjectFace<AgentModeLabelInjected>
+
+export function AgentModeLabel({
+  sessionId, useSessions, useAgentModes, load, t,
+}: AgentModeLabelProps) {
+  const modeId = useSessions(state => modeIdFromSession(state.byId[sessionId]))
+  const options = useAgentModes(state => state.options)
+
+  useEffect(() => {
+    if (modeId !== undefined) void load()
+  }, [modeId, load])
+
+  if (modeId === undefined) return null
+  const option = options.find(entry => entry.id === modeId)
+  const text = option === undefined ? undefined : modeDisplayText(option, t)
+  return (
+    <span className={css.label} title={text?.description ?? t('headerHint')}>
+      <IconAgentModeOutline16 size={14} className={css.icon} />
+      {text?.name ?? modeId}
+    </span>
+  )
+}
