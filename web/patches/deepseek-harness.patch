+/** Browser-only adapter from Native Agent Mode semantics to the frozen agentPreset RPC contract. */
+import type { IApiClient } from '@deepseek-ai/dsh-api-remotes/client'
+import type { SessionId } from '@deepseek-ai/dsh-client-runtime/client'
+
+export const AGENT_MODE_SETTINGS_WIRE_NAMESPACE = 'agent-presets'
+export const AGENT_MODE_SELECTED_WIRE_EVENT = 'agent-preset/selected'
+
+export interface AgentModeSummary {
+  id: string
+  origin: 'builtin' | 'user'
+  isDefault: boolean
+  name?: string
+  description?: string
+  broken?: string
+}
+
+export interface AgentModeRoster {
+  modes: readonly AgentModeSummary[]
+  authorable: boolean
+  hasDocument: boolean
+}
+
+export interface AgentModeDocument {
+  id: string
+  origin: 'builtin' | 'user'
+  content: string
+  name?: string
+  description?: string
+}
+
+export type AgentModeResult<T> = { ok: true; value: T } | { ok: false; error: string }
+
+type WireEnvelope<T> = {
+  result: { ok: true; value: T } | { ok: false; error: { message: string } }
+}
+
+async function call<T, U>(
+  request: () => Promise<WireEnvelope<T>>,
+  project: (value: T) => U,
+): Promise<AgentModeResult<U>> {
+  try {
+    const response = await request()
+    return response.result.ok
+      ? { ok: true, value: project(response.result.value) }
+      : { ok: false, error: response.result.error.message }
+  } catch (error) {
+    return { ok: false, error: error instanceof Error ? error.message : String(error) }
+  }
+}
+
+export interface AgentModeWire {
+  list: () => Promise<AgentModeResult<AgentModeRoster>>
+  settingsWritable: () => Promise<AgentModeResult<boolean>>
+  setDefault: (modeId: string) => Promise<AgentModeResult<void>>
+  select: (sessionId: SessionId, modeId: string) => Promise<AgentModeResult<string>>
+  read: (modeId: string) => Promise<AgentModeResult<AgentModeDocument>>
+  copy: (from: string, modeId: string, name?: string) => Promise<AgentModeResult<string>>
+  open: (modeId: string) => Promise<AgentModeResult<{ opened: true } | { opened: false; path: string }>>
+  remove: (modeId: string) => Promise<AgentModeResult<void>>
+}
+
+export function createAgentModeWire(api: IApiClient): AgentModeWire {
+  return {
+    list: () => call(
+      () => api.agentPresets.list({}),
+      value => ({
+        modes: value.presets.map(entry => ({
+          id: entry.id,
+          origin: entry.trust === 'user' ? 'user' : 'builtin',
+          isDefault: entry.isDefault,
+          ...(entry.name === undefined ? {} : { name: entry.name }),
+          ...(entry.description === undefined ? {} : { description: entry.description }),
+          ...(entry.broken === undefined ? {} : { broken: entry.broken }),
+        })),
+        authorable: value.authorable,
+        hasDocument: value.hasDocument,
+      }),
+    ),
+    settingsWritable: () => call(
+      () => api.settings.describe({}),
+      value => value.writable,
+    ),
+    setDefault: modeId => call(
+      () => api.settings.update({
+        ns: AGENT_MODE_SETTINGS_WIRE_NAMESPACE,
+        patch: { default: modeId },
+      }),
+      () => undefined,
+    ),
+    select: (sessionId, modeId) => call(
+      () => api.agentPresets.select({ sessionId, agentPreset: modeId }),
+      value => value.agentPreset,
+    ),
+    read: modeId => call(
+      () => api.agentPresets.read({ agentPreset: modeId }),
+      value => ({
+        id: value.agentPreset,
+        origin: value.trust === 'user' ? 'user' : 'builtin',
+        content: value.content,
+        ...(value.name === undefined ? {} : { name: value.name }),
+        ...(value.description === undefined ? {} : { description: value.description }),
+      }),
+    ),
+    copy: (from, modeId, name) => call(
+      () => api.agentPresets.copy({
+        from,
+        agentPreset: modeId,
+        ...(name === undefined ? {} : { name }),
+      }),
+      value => value.agentPreset,
+    ),
+    open: modeId => call(
+      () => api.agentPresets.openDocument({ agentPreset: modeId }),
+      value => value,
+    ),
+    remove: modeId => call(
+      () => api.agentPresets.remove({ agentPreset: modeId }),
+      () => undefined,
+    ),
+  }
+}
+
+/** Read the compatibility session projection without leaking its field name into mode UI. */
+export function modeIdFromSession(session: { agentPreset?: string } | undefined): string | undefined {
+  return session?.agentPreset
+}
+
+/** Publish a selected mode through the compatibility session-store boundary. */
+export function recordSessionMode(
+  sessions: { noteAgentPreset: (sessionId: SessionId, agentPreset: string) => void },
+  sessionId: SessionId,
+  modeId: string,
+): void {
+  sessions.noteAgentPreset(sessionId, modeId)
+}
