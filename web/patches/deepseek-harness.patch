+
+/** Render Tessivum's mark and custom vector wordmark. */
+export function TessivumWordmark({ size = 24, className }: IconProps) {
+  return (
+    <svg
+      width={(size * 126) / 24}
+      height={size}
+      className={className}
+      viewBox="0 0 126 24"
