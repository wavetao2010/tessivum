+/** General-settings row choosing the default Native Agent Mode. */
+import { useEffect, useState } from 'react'
+import type { SnapshotStore } from '@deepseek-ai/dsh-client-runtime/client'
+import type { InjectFace, PropsLocale, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import type { AgentModeSettingsState } from './settings-store.ts'
+import { modeDisplayText, type AgentModeSettingsKey } from './locales.ts'
+import { ModeMenu } from './ModeMenu.tsx'
+import css from './AgentModeRow.module.css'
+
+export interface AgentModeRowInjected {
+  hooks: { agentMode: SnapshotStore<AgentModeSettingsState> }
+  load: () => Promise<void>
+  select: (id: string) => Promise<void>
+}
+
+export type AgentModeRowProps =
+  PropsRuntime<'settings.general.item'>
+  & PropsLocale<'settings.agentMode'>
+  & InjectFace<AgentModeRowInjected>
+
+export function AgentModeRow({ load, select, useAgentMode, t }: AgentModeRowProps) {
+  const state = useAgentMode(snapshot => snapshot)
+  const [open, setOpen] = useState(false)
+
+  useEffect(() => { void load() }, [load])
+  useEffect(() => {
+    if (state.writable && state.status !== 'unavailable') return
+    setOpen(false)
+  }, [state.status, state.writable])
+
+  if (state.status === 'unavailable') return null
+  const busy = state.status === 'loading' || state.status === 'saving'
+  const chosen = state.options.find(option => option.id === state.currentValue)
+  const chosenText = chosen === undefined ? undefined : modeDisplayText(chosen, t)
+  const label = state.currentValue === '' ? t('loading') : (chosenText?.name ?? state.currentValue)
+
+  return (
+    <div className={css.row}>
+      <div className={css.rowText}>
+        <div className={css.title}>{t('title')}</div>
+        <div className={css.desc} role={state.error === null ? undefined : 'alert'}>
+          {state.error ?? t('description')}
+        </div>
+      </div>
+      <ModeMenu
+        options={state.options}
+        selectedId={state.currentValue}
+        label={label}
+        t={t as (key: AgentModeSettingsKey) => string}
+        buttonClassName={css.selector}
+        chevronClassName={css.chevron}
+        disabled={busy || !state.writable || state.options.length === 0}
+        open={open}
+        onOpenChange={setOpen}
+        onSelect={(id) => { void select(id) }}
+      />
+    </div>
+  )
+}
+
+declare module '@deepseek-ai/dsh-client-ui-slots' {
+  interface LocaleNamespaceMap {
+    'settings.agentMode': AgentModeSettingsKey
+  }
+}
