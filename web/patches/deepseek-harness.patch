+import { describe, expect, it } from 'vitest'
+import type { IApiClient } from '@deepseek-ai/dsh-api-remotes/client'
+import type { SessionId } from '@deepseek-ai/dsh-client-runtime/client'
+import { createAgentModeWire, modeIdFromSession } from '../src/client/mode-wire.ts'
+
+const success = (value: unknown) => Promise.resolve({
+  rpcId: 'r', result: { ok: true as const, value },
+})
+
+describe('the frozen Browser RPC adapter', () => {
+  it('projects the Native Agent Mode roster without leaking legacy semantics', async () => {
+    const api = {
+      agentPresets: {
+        list: () => success({
+          presets: [
+            { id: 'standard', trust: 'system', isDefault: true, name: 'Standard' },
+            { id: 'mine', trust: 'user', isDefault: false, name: 'Mine' },
+          ],
+          authorable: true,
+          hasDocument: false,
+        }),
+      },
+    } as unknown as IApiClient
+
+    const listed = await createAgentModeWire(api).list()
+    expect(listed).toEqual({
+      ok: true,
+      value: {
+        modes: [
+          { id: 'standard', origin: 'builtin', isDefault: true, name: 'Standard' },
+          { id: 'mine', origin: 'user', isDefault: false, name: 'Mine' },
+        ],
+        authorable: true,
+        hasDocument: false,
+      },
+    })
+  })
+
+  it('keeps every frozen method name and payload key inside one adapter', async () => {
+    const calls: { method: string; payload: unknown }[] = []
+    const api = {
+      agentPresets: {
+        list: () => success({ presets: [], authorable: true, hasDocument: false }),
+        select: (payload: unknown) => { calls.push({ method: 'agentPreset.select', payload }); return success({ agentPreset: 'minimal' }) },
+        read: (payload: unknown) => { calls.push({ method: 'agentPreset.read', payload }); return success({ agentPreset: 'minimal', trust: 'system', content: 'schema = 1\n' }) },
+        copy: (payload: unknown) => { calls.push({ method: 'agentPreset.copy', payload }); return success({ agentPreset: 'mine' }) },
+        openDocument: (payload: unknown) => { calls.push({ method: 'agentPreset.openDocument', payload }); return success({ opened: false, path: '/modes/mine/mode.toml' }) },
+        remove: (payload: unknown) => { calls.push({ method: 'agentPreset.remove', payload }); return success({}) },
+      },
+      settings: {
+        describe: () => success({ writable: true, hasDocument: true, namespaces: [] }),
+        update: (payload: unknown) => { calls.push({ method: 'settings.update', payload }); return success({}) },
+      },
+    } as unknown as IApiClient
+    const wire = createAgentModeWire(api)
+
+    await wire.select('s1' as SessionId, 'minimal')
+    await wire.read('minimal')
+    await wire.copy('minimal', 'mine', 'Mine')
+    await wire.open('mine')
+    await wire.remove('mine')
+    await wire.setDefault('minimal')
+
+    expect(calls).toEqual([
+      { method: 'agentPreset.select', payload: { sessionId: 's1', agentPreset: 'minimal' } },
+      { method: 'agentPreset.read', payload: { agentPreset: 'minimal' } },
+      { method: 'agentPreset.copy', payload: { from: 'minimal', agentPreset: 'mine', name: 'Mine' } },
+      { method: 'agentPreset.openDocument', payload: { agentPreset: 'mine' } },
+      { method: 'agentPreset.remove', payload: { agentPreset: 'mine' } },
+      { method: 'settings.update', payload: { ns: 'agent-presets', patch: { default: 'minimal' } } },
+    ])
+  })
+
+  it('reads session projection only at the compatibility boundary', () => {
+    expect(modeIdFromSession({ agentPreset: 'composition' })).toBe('composition')
+    expect(modeIdFromSession(undefined)).toBeUndefined()
+  })
+})
